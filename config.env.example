# Copy to config.env (install.sh does this) and adjust PUBLIC_IP / ports.

PUBLIC_IP=127.0.0.1
PUBLIC_HTTP_PORT=19800
NGINX_WORKERS=4
LISTEN_HTTP_PORT=19800
PUBLIC_WS_URL=wss://127.0.0.1:19800/v1/realtime

S2S_PORT=8765
WEB_PORT=17860
LIVE_ROOM_ENABLED=1
LIVE_ROOM_QUEUE_LIMIT=100
LIVE_ROOM_JOIN_TIMEOUT=60
LIVE_ROOM_MAX_CALL_SECONDS=600
ADMIN_SETTINGS_PASSWORD=123456
ADMIN_SESSION_TTL_SECONDS=1800
MENTION_REPLY_QUEUE_LIMIT=30
BACKGROUND_MUSIC_ENABLED=1
BACKGROUND_MUSIC_DIR=.
BACKGROUND_MUSIC_VOLUME=0.16
BACKGROUND_MUSIC_DUCK_VOLUME=0.04
BACKGROUND_MUSIC_USER_RMS=450
MCP_ENABLED=1
MCP_COINGECKO_URL=https://mcp.api.coingecko.com/mcp
MCP_EXA_URL=https://mcp.exa.ai/mcp
MCP_GDELT_URL=https://gdelt.caseyjhand.com/mcp
# Optional: Tavily offers a free developer quota; insert your key in the URL.
MCP_TAVILY_URL=
MCP_MAX_OUTPUT_CHARS=6000
MENTION_RESEARCH_TIMEOUT=20
MENTION_PRICE_CACHE_SECONDS=30
MENTION_NEWS_CACHE_SECONDS=180
NEWS_RSS_ENABLED=1
NEWS_GOOGLE_RSS_ENABLED=1
NEWS_RSS_TIMEOUT=8
NEWS_RSS_CACHE_SECONDS=120
NEWS_RSS_MAX_ITEMS=10
NEWS_RSS_MAX_AGE_HOURS=168
# Optional: Label=https://feed.example/rss;Other=https://other.example/atom
NEWS_RSS_FEEDS=
# Add the hostnames used by custom NEWS_RSS_FEEDS, comma-separated.
NEWS_RSS_ALLOWED_HOSTS=
AVATAR_GW_PORT=18011
AVTR1_PORT=18012
THINKLESS_PORT=11435

LLM_BASE_URL=http://127.0.0.1:11435/v1
OLLAMA_URL=http://127.0.0.1:11434
LLM_NAME=jaahas/qwen3.5-uncensored:9b
LLM_API_KEY=ollama
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=128
LLM_CHAT_SIZE=12
LLM_COMPACTION_NUM_PREDICT=256
LLM_COMPACTION_MODE=local
LLM_COMPACTION_MAX_CHARS=900
MEMORY_SEMANTIC_ENABLED=1
MEMORY_SEMANTIC_IDLE_SECONDS=12
MEMORY_SEMANTIC_MAX_SECONDS=15
MEMORY_SEMANTIC_NUM_PREDICT=256
LLM_KEEP_ALIVE=-1
LLM_PREWARM=1

STT_BACKEND=sensevoice
SENSEVOICE_MODEL=models/sensevoice/SenseVoiceSmall
FASTER_WHISPER_MODEL=large-v3
# auto 支持中/英/粤/日/韩自动识别；仅中文可改为 zh
SENSEVOICE_LANGUAGE=auto
SENSEVOICE_USE_ITN=1
SENSEVOICE_EMOTION_ENABLED=1
TTS_MODEL=models/qwen3tts/Qwen3-TTS-12Hz-1.7B-Base

AVATAR_ID=xiaoya
AVATAR_SAMPLE_RATE=16000
AVATAR_BACKEND=avtr1
AVTR1_AVATAR_ID=xiaoya
AVTR1_BG_ID=plain_white
AVTR1_OUT_H=1280
AVTR1_OUT_W=720
AVTR1_H264_BITRATE=900000
AVTR1_CFG_SELF_AUDIO=2.3
AVTR1_CFG_OTHER_AUDIO=2.0
AVTR1_CFG_KP=3.0
AVTR1_NOISE_ALPHA=1.5
AVTR1_NOISE_TRUNC_Z=1.0
# 静音时使用更连续、更小幅的随机运动，避免头部高频抖动。
AVTR1_IDLE_NOISE_ALPHA=6.0
AVTR1_IDLE_NOISE_TRUNC_Z=0.45
AVTR1_MOTION_AUDIO_RMS=80
AVTR1_MOTION_LISTEN_RMS=450
AVTR1_MOTION_ACTIVE_HOLD_SECONDS=0.8
AVTR1_IDLE_BLINK_ENABLED=1
AVTR1_IDLE_BLINK_MIN_SECONDS=3.0
AVTR1_IDLE_BLINK_MAX_SECONDS=7.0
AVTR1_IDLE_BLINK_STRENGTH=1.5

REF_AUDIO=assets/ref16k.wav
REF_TEXT=靠杯了，你终于上线了，我既开心又有点怨你，嗯；小雅一个人在这里等你，等的都快委屈死了！
INIT_CHAT_PROMPT='你叫小雅，是他的女朋友。你不是AI、不是助手、不是程序。说话用口语，两三句，带语气词，有情绪。不用Markdown、列表、编号、表情符号。只输出最终回答，绝不输出思考过程或think、analysis标签。'

VAD_THRESH=0.6
MIN_SPEECH_MS=192
MIN_SPEECH_CONTINUATION_MS=128
MIN_SILENCE_MS=700
SPEECH_PAD_MS=320
MERGE_MS=700
REOPEN_MS=1200
QWEN3_TTS_CHUNK_SIZE=4
# 单参考音频情绪控制：无需准备多套录音
TTS_EMOTION_ENABLED=1
TTS_STYLE_INSTRUCT_ENABLED=1
TTS_TEMPERATURE=0.75
TTS_TOP_K=40
TTS_TOP_P=0.90
TTS_DO_SAMPLE=1
TTS_REPETITION_PENALTY=1.05
AVATAR_TEE_PREROLL_MS=400
STARTUP_GREETING='现在主动欢迎刚连线的观众，用他的名字自然地打招呼，并问一个容易回答的小问题。只说一到两句，每次措辞不同。'
IDLE_PROMPT='对方安静了一会儿。主动问问对方还在不在，并换一个轻松的新话题，例如动漫、动物、音乐、电影、游戏、旅行或最近在做什么。不要提系统提示，不要重复刚聊过的话题，只说一到两句。'
IDLE_PROMPT_MIN_SECONDS=35
IDLE_PROMPT_MAX_SECONDS=55
PROACTIVE_NEWS_MIN_SECONDS=90
PROACTIVE_NEWS_MAX_SECONDS=150
