# Copy to config.env (install.sh does this) and adjust PUBLIC_IP / ports.

PUBLIC_IP=127.0.0.1
PUBLIC_HTTP_PORT=19800
NGINX_WORKERS=4
LISTEN_HTTP_PORT=19800
PUBLIC_WS_URL=wss://127.0.0.1:19800/v1/realtime

S2S_PORT=8765
WEB_PORT=17860
LIVE_ROOM_ENABLED=1
LIVE_ROOM_QUEUE_LIMIT=100
LIVE_ROOM_JOIN_TIMEOUT=60
LIVE_ROOM_MAX_CALL_SECONDS=600
ADMIN_SETTINGS_PASSWORD=123456
ADMIN_SESSION_TTL_SECONDS=1800
ROOM_DB_PATH=data/live_room.sqlite3
ROOM_IP_RETENTION_DAYS=30
# Live-room weather scene (Open-Meteo, no key). Failures fall back to the clock.
ROOM_DECOR_LAT=30.67
ROOM_DECOR_LON=104.07
ROOM_DECOR_TZ=Asia/Shanghai
MENTION_REPLY_QUEUE_LIMIT=30
BACKGROUND_MUSIC_ENABLED=1
BACKGROUND_MUSIC_DIR=assets/music
BACKGROUND_MUSIC_VOLUME=0.16
BACKGROUND_MUSIC_DUCK_VOLUME=0.04
BACKGROUND_MUSIC_USER_RMS=450
MCP_ENABLED=1
# 直播对话默认只做陪伴聊天；后台主动新闻仍可独立使用 RSS。
DIALOGUE_TOOLS_ENABLED=0
MCP_COINGECKO_URL=https://mcp.api.coingecko.com/mcp
MCP_EXA_URL=https://mcp.exa.ai/mcp
MCP_GDELT_URL=https://gdelt.caseyjhand.com/mcp
# Optional: Tavily offers a free developer quota; insert your key in the URL.
MCP_TAVILY_URL=
MCP_MAX_OUTPUT_CHARS=6000
# Smart web search: Tavily is primary, Exa is fallback, self-hosted SearXNG is last.
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
SEARXNG_URL=
JINA_READER_ENABLED=1
SMART_SEARCH_TIMEOUT_SECONDS=5
SMART_SEARCH_EVIDENCE_BUDGET_SECONDS=3.5
SMART_SEARCH_CACHE_SECONDS=180
SMART_SEARCH_COOLDOWN_SECONDS=60
NEWS_RSS_ENABLED=1
NEWS_GOOGLE_RSS_ENABLED=1
NEWS_RSS_TIMEOUT=8
NEWS_RSS_CACHE_SECONDS=120
NEWS_RSS_MAX_ITEMS=10
NEWS_RSS_MAX_AGE_HOURS=72
# 默认主动话题池：iDaily、中新网国际、澎湃、人民日报、极客公园、cnBeta、IT之家、知乎日报。
# Optional override: Label=https://feed.example/rss;Other=https://other.example/atom
NEWS_RSS_FEEDS=
# Add the hostnames used by custom NEWS_RSS_FEEDS, comma-separated.
NEWS_RSS_ALLOWED_HOSTS=
AVATAR_GW_PORT=18011
AVTR1_PORT=18012
THINKLESS_PORT=11435

# Optional high-quality primary LLM. The proxy must only listen on loopback;
# run `grok login --device-auth` once on the server before enabling it.
GROK_ENABLED=0
GROK_PROXY_PORT=18080
GROK_PROXY_BASE_URL=http://127.0.0.1:18080/v1
GROK_MODEL=grok-4.6
GROK_REASONING_EFFORT=low
GROK_TIMEOUT_SECONDS=45
GROK_MAX_CONCURRENCY_PER_ACCOUNT=2

# Optional second local model that only speaks a first bridging clause.
# Off by default; keep it off when LOCAL_LEAD_MODEL equals LLM_NAME.
LOCAL_LEAD_ENABLED=0
LOCAL_LEAD_MODEL=jaahas/qwen3.5-uncensored:9b

# WebRTC/WHEP is the primary viewer transport; HTTP-FLV remains automatic
# fallback. Publish both UDP and TCP ports in Docker/security groups.
WEBRTC_ENABLED=1
WEBRTC_PUBLIC_HOST=
WEBRTC_UDP_PORT=8189
WEBRTC_TCP_PORT=8190
MEDIAMTX_WHEP_PORT=18889
MEDIAMTX_RTSP_PORT=18554
MEDIAMTX_API_PORT=19997
MEDIAMTX_METRICS_PORT=19998
WEBRTC_OPUS_BITRATE=48000
WEBRTC_MUSIC_OPUS_BITRATE=64000
WEBRTC_PACKET_LOSS_PERCENT=5

LLM_BASE_URL=http://127.0.0.1:11435/v1
OLLAMA_URL=http://127.0.0.1:11434
LLM_NAME=jaahas/qwen3.5-uncensored:9b
LLM_API_KEY=ollama
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=256
# Socket inactivity window for local streaming generation.  A short value can
# turn a temporary GPU scheduling pause into a falsely completed half-sentence.
LLM_LOCAL_READ_TIMEOUT_SECONDS=12
LLM_LOCAL_CONVERSATION_NUM_PREDICT=160
# News shares the hidden delivery tag with spoken Chinese. 128 tokens often
# stopped a recap mid-clause. Buffer + continue/retry keeps the last sentence whole.
LLM_NEWS_NUM_PREDICT=256
LLM_NEWS_CONTINUE_NUM_PREDICT=128
LLM_NEWS_RETRY_NUM_PREDICT=256
LLM_DIALOGUE_CONTINUE_NUM_PREDICT=128
LLM_BUFFERED_READ_TIMEOUT_SECONDS=45
LLM_CHAT_SIZE=12
LLM_STREAM_BATCH_SENTENCES=1
AGENT_FOCUS_TTL_SECONDS=1800
AGENT_PROACTIVE_COOLDOWN_SECONDS=60
AGENT_TIMEZONE=Asia/Shanghai
LLM_COMPACTION_NUM_PREDICT=256
LLM_COMPACTION_MODE=local
LLM_COMPACTION_MAX_CHARS=900
MEMORY_SEMANTIC_ENABLED=1
MEMORY_SEMANTIC_IDLE_SECONDS=12
MEMORY_SEMANTIC_MAX_SECONDS=15
MEMORY_SEMANTIC_NUM_PREDICT=256
LLM_KEEP_ALIVE=-1
LLM_PREWARM=1

STT_BACKEND=sensevoice
SENSEVOICE_MODEL=models/sensevoice/SenseVoiceSmall
FASTER_WHISPER_MODEL=large-v3
# auto 支持中/英/粤/日/韩自动识别；仅中文可改为 zh
SENSEVOICE_LANGUAGE=auto
SENSEVOICE_USE_ITN=1
SENSEVOICE_EMOTION_ENABLED=1
TTS_MODEL=models/fish-s2-pro
FISH_S2_PORT=18781
FISH_S2_URL=http://127.0.0.1:18781
# fish_s2 starts our own Fish worker. voxcpm_shared queues on the
# already-running localization VoxCPM2 at :10102 and does not load a second copy.
TTS_BACKEND=fish_s2
VOXCPM_SHARED_URL=http://127.0.0.1:10102
# Long news clones often run faster than the 4.2 hanzi/s reference clip.
# Stretch only when a clip is clearly rushed; short welcomes are left alone.
VOXCPM_TARGET_HANZI_PER_SEC=4.5
VOXCPM_PACE_FAST_THRESHOLD=5.0
VOXCPM_MIN_ATEMPO=0.86
# Dialogue starts playing after this much streamed PCM; news still waits.
VOXCPM_PLAY_RESERVOIR_SECONDS=1.2
# Dialogue clone steps. 10 is official default; 8 is faster and still stable.
VOXCPM_DIALOGUE_TIMESTEPS=8
# Leave empty to read the key from the running voxcpm_server.py process.
# VOXCPM_API_KEY=

AVATAR_ID=xiaoya_locket
AVATAR_SAMPLE_RATE=16000
AVATAR_BACKEND=avtr1
AVTR1_AVATAR_ID=xiaoya_locket
AVTR1_BG_ID=plain_white
AVTR1_OUT_H=1280
AVTR1_OUT_W=720
AVTR1_H264_BITRATE=900000
AVTR1_CFG_SELF_AUDIO=2.3
AVTR1_CFG_OTHER_AUDIO=2.0
AVTR1_CFG_KP=3.0
AVTR1_NOISE_ALPHA=1.5
AVTR1_NOISE_TRUNC_Z=1.0
# 静音时使用更连续、更小幅的随机运动，避免头部高频抖动。
AVTR1_IDLE_NOISE_ALPHA=6.0
AVTR1_IDLE_NOISE_TRUNC_Z=0.45
AVTR1_MOTION_AUDIO_RMS=80
AVTR1_MOTION_LISTEN_RMS=450
AVTR1_MOTION_ACTIVE_HOLD_SECONDS=0.8
# 自然眨眼在待机和说话时都启用；包含快闭慢开、部分眨眼和偶发连眨。
AVTR1_BLINK_ENABLED=1
AVTR1_BLINK_MIN_SECONDS=2.6
AVTR1_BLINK_MAX_SECONDS=7.2
AVTR1_BLINK_STRENGTH=1.45
AVTR1_BLINK_SPEECH_STRENGTH=1.08
AVTR1_BLINK_SPEECH_INTERVAL_SCALE=0.72
AVTR1_BLINK_DOUBLE_PROBABILITY=0.10
AVTR1_BLINK_PARTIAL_PROBABILITY=0.16
# 仅待机时叠加低频呼吸/重心微动，说话时平滑淡出。
AVTR1_IDLE_BREATH_ENABLED=1
AVTR1_IDLE_BREATH_POSE_DEGREES=0.14
# 安静时随机触发思考、嘟嘴、鼓腮和快速/连续眨眼组合。
AVTR1_IDLE_EXPRESSION_ENABLED=1
AVTR1_IDLE_EXPRESSION_MIN_SECONDS=2.0
AVTR1_IDLE_EXPRESSION_MAX_SECONDS=4.5
AVTR1_IDLE_EXPRESSION_INTENSITY=0.64
AVTR1_IDLE_EXPRESSION_QUIET_SECONDS=1.8

REF_AUDIO=assets/ref_fish.wav
REF_TEXT=靠杯了，你终于上线了，我既开心又有点怨你，嗯；小雅一个人在这里等你，等的都快委屈死了！小雅一个人在这里等你，等的都快委屈死了！
INIT_CHAT_PROMPT='你叫小麻，直播间里一个甜、直接、有点坏的女孩。先答正事，短句直说，能一句就一句。不要用既然……那就……、所以说、换句话说这类书面转折。可以有自然磕绊，像嗯——、那个、我是说，但别句句都磕，也别装结巴。坏是俏皮不是阴阳。难过或认真的事先认真陪。不用Markdown、列表、表情和HTML，只输出能说出口的话。'

VAD_THRESH=0.6
MIN_SPEECH_MS=192
MIN_SPEECH_CONTINUATION_MS=128
MIN_SILENCE_MS=700
SPEECH_PAD_MS=320
MERGE_MS=700
REOPEN_MS=1200
QWEN3_TTS_CHUNK_SIZE=4
# 单参考音频情绪控制：无需准备多套录音
TTS_EMOTION_ENABLED=1
TTS_STYLE_INSTRUCT_ENABLED=1
# 只调整实际朗读文本的标点与韵律，聊天区仍显示 LLM 原文。
TTS_PROSODY_ENABLED=1
TTS_PROSODY_MAX_CLAUSE_CHARS=20
TTS_TEMPERATURE=0.65
TTS_TOP_K=30
TTS_TOP_P=0.85
TTS_DO_SAMPLE=1
TTS_REPETITION_PENALTY=1.05
AVATAR_TEE_UPLOAD_PREROLL_MS=320
AVATAR_TEE_SEGMENT_GAP_MS=14000
AVTR1_SPEECH_START_BUFFER_MS=600
AVTR1_AUDIO_REBUFFER_STEP_MS=200
AVTR1_AUDIO_MAX_BUFFER_MS=1400
AVTR1_OUTPUT_RESERVOIR_MS=800
AVTR1_MAX_SPEECH_SECONDS=90
STARTUP_GREETING='现在主动欢迎刚连线的观众，用他的名字自然地打招呼，并问一个容易回答的小问题。只说一到两句，每次措辞不同。'
IDLE_PROMPT='对方安静了一会儿。主动问问对方还在不在，并换一个轻松的新话题，例如动漫、动物、音乐、电影、游戏、旅行或最近在做什么。不要提系统提示，不要重复刚聊过的话题，只说一到两句。'
IDLE_PROMPT_MIN_SECONDS=35
IDLE_PROMPT_MAX_SECONDS=55
PROACTIVE_NEWS_MIN_SECONDS=90
PROACTIVE_NEWS_MAX_SECONDS=150
